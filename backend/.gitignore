/bin/
/dist/
/rig
*.test
coverage.out
coverage.html

# internal/webui/dist/ ships a committed placeholder index.html so `go build`
# works on a fresh checkout; from backend/, local `pnpm --dir ../frontend
# build && cp -r ../frontend/dist/* internal/webui/dist/` overwrites it with
# the real UI for `go run` — that real build output shouldn't get committed
# (Docker rebuilds it fresh).
internal/webui/dist/*
!internal/webui/dist/index.html

# Local secrets — .env ships with dev-safe placeholders in version control;
# once NEO4J_PASSWORD etc. become real secrets, this keeps edits local.
.env.local
