# ============================================================
# rig platform — environment configuration for `docker compose up`
# ============================================================
# Docker Compose auto-loads this file (same directory as docker-compose.yml)
# to fill in the ${VAR} references there. Edit the two REQUIRED values below
# before starting; everything else has a working local default.
#
# Once NEO4J_PASSWORD is a real secret, stop tracking this file in git (see
# .gitignore) — the placeholder here is for local dev only.

# ---- REQUIRED ---------------------------------------------------------

# Auth for the bundled Neo4j container (min 8 characters). Also passed
# through to the rig service as GRAPH_NEO4J_PASSWORD.
NEO4J_PASSWORD=change-me-dev-password

# Host directory scanned for *.code-workspace files, bind-mounted read-only
# into the rig container at WORKSPACE_ROOT=/workspaces. No safe default.
# This is the curated hub of real workspace files — NOT ~/Development itself,
# which also contains v1's resolver/scanner *test fixture* .code-workspace
# files (packages/resolver/test/fixtures/**, packages/server/test/fixtures/**)
# that would otherwise show up as fake "projects".
RIG_WORKSPACES_HOST_DIR=/Users/somniactic/Development/workspaces

# ---- Optional: host port mapping ---------------------------------------

# Host port serving rig's REST + MCP endpoint (container always listens on
# :8789 internally — see RIG_HTTP_ADDR below).
RIG_HTTP_PORT=8789

# Host ports for Neo4j Browser (HTTP) and Bolt, if you want to poke at the
# graph directly at http://localhost:7474.
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ---- Reference: rig service config set directly in docker-compose.yml -
# RIG_HTTP_ADDR=:8789
# GRAPH_NEO4J_URI=neo4j://neo4j:7687
# GRAPH_NEO4J_USERNAME=neo4j
# GRAPH_NEO4J_PASSWORD=${NEO4J_PASSWORD}
# GRAPH_NEO4J_DATABASE=neo4j
# WORKSPACE_ROOT=/workspaces
#
# These are pinned to the bundled `neo4j` container's topology rather than
# left overridable here. To point rig at a different Neo4j instance (e.g.
# Aura) instead of the bundled container, edit them directly in
# docker-compose.yml and drop the `neo4j` service.
